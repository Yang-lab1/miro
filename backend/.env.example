APP_NAME=miro-backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_SITE_URL=
# Frontend-only flag; keep false for hosted builds so unavailable APIs cannot look like a real round.
MIRO_ALLOW_LOCAL_FALLBACK=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/miro
DATABASE_ECHO=false
ENABLE_DOCS=true
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
ALLOW_DEMO_ACTOR_FALLBACK=false
DEMO_USER_EMAIL=demo@miro.local
REALTIME_PROVIDER_MODE=stub
HARDWARE_PROVIDER_MODE=demo
# Production requires a real HTTPS bridge. The bridge receives the review packet
# and must return a 2xx response before Miro records the sync as completed.
HARDWARE_PROVIDER_URL=
HARDWARE_PROVIDER_API_KEY=
HARDWARE_PROVIDER_TIMEOUT_SECONDS=10
# Browser Voice uses the browser's real microphone/recognition plus backend text turns.
BROWSER_VOICE_FALLBACK_ENABLED=true

# Text turn and interview-outline generation. Keep rule_based for a local/demo run; use
# openai_compatible only after setting a server-side API key.
LLM_PROVIDER_MODE=rule_based
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Minimal local voice MVP:
#   DOUBAO_APP_ID
#   DOUBAO_ACCESS_TOKEN
#   DOUBAO_SPEAKER
# DOUBAO_SECRET_KEY is optional unless your actual Doubao app setup requires it.
# --- Doubao / Volcengine Realtime Dialogue ---
# Fill these with the values from your Volcengine console -> 实时语音大模型.
# Do NOT commit .env. Only .env.example is safe to commit (no real values).
DOUBAO_APP_ID=
DOUBAO_API_KEY=
DOUBAO_ACCESS_TOKEN=
DOUBAO_SECRET_KEY=
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6
DOUBAO_SPEAKER=zh_female_vv_jupiter_bigtts
DOUBAO_MODEL=1.2.1.1
DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
